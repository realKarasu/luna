{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Luna",
  "version": "0.2.0",
  "identifier": "app.luna.displaytuner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Luna",
        "width": 1240,
        "height": 800,
        "minWidth": 1020,
        "minHeight": 660,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Luna contributors",
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "Per-screen display tuning for PC games",
    "longDescription": "Luna tunes gamma, colour and vibrance per monitor, adds a crosshair overlay, a look wheel, Ultra Zoom and one-click Windows gaming tweaks. Everything runs locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
